PORT=3001

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# 'true' za managed servise koji zahtijevaju TLS (npr. Upstash) - ostavi prazno/false za lokalni Docker Redis.
REDIS_TLS=

# Ista Postgres baza koju koristi ../api servis - ovaj gateway samo CITA
# restaurant_tables (verifikacija QR tokena), nikad ne pise narudzbe direktno.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restoran?schema=public"

# Glavni API servis - ovamo se salje POST /orders/internal kad gost pošalje `place_order`,
# i PATCH orders/menu rute kad osoblje (KDS) mijenja status narudžbe ili dostupnost artikla.
API_BASE_URL=http://localhost:3000/api
INTERNAL_SERVICE_SECRET=change-me

# MORA biti identican JWT_SECRET-u u ../api/.env - ovaj gateway verifikuje
# staff JWT token pri `join_staff_session` bez dodatnog poziva ka API-ju.
JWT_SECRET=change-me-to-a-long-random-string

# Koliko dugo (sekunde) drzimo "otvorenu" sesiju stola u Redisu bez aktivnosti
# prije nego je smatramo istekloh (npr. gosti otisli, sto pospremljen)
TABLE_SESSION_TTL_SECONDS=14400

# Dozvoljeni origini za CORS (frontend PWA, konobarski web, KDS)
CORS_ORIGINS=https://app.domain.com,https://staff.domain.com
