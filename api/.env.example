PORT=3000

# Sopstveni javni URL ovog API-ja - koristi se SAMO za građenje apsolutnih linkova ka otpremljenim slikama (vidi uploads/uploads.service.ts)
API_PUBLIC_URL=https://api.domain.com

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restoran?schema=public"

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Dugovjecan token za /auth/refresh - klijent ga koristi da dobije nov access_token bez ponovne prijave
REFRESH_EXPIRES_IN=30d

# Tajni token koji print-gateway agenti moraju poslati da bi se povezali na /agents namespace
PRINT_AGENT_SHARED_SECRET=change-me

# Tajni header koji websocket-gateway (guest realtime servis) koristi da pozove
# interne /internal/orders rute ovog API-ja (service-to-service auth, ne za javnost)
INTERNAL_SERVICE_SECRET=change-me

CORS_ORIGINS=https://app.domain.com,https://staff.domain.com

# Koristi se za success/cancel URL-ove nakon Stripe Checkout-a (takeaway online placanje, modul D.3)
PWA_BASE_URL=https://app.domain.com

# Opciono - error tracking. Bez ovoga Sentry se jednostavno ne inicijalizuje (nema greske).
SENTRY_DSN=

# Koliko dana traje besplatni probni period nakon self-registracije (POST /auth/register)
TRIAL_DAYS=14

# "Zaboravljena lozinka" - link u emailu vodi na ovu (staff/admin) stranicu + ?token=...
STAFF_RESET_PASSWORD_URL=https://staff.domain.com/reset-password

# SMTP (transakcioni email - trenutno samo forgot-password). Prazno = graciozno
# preskace slanje i ispisuje link u log (dev fallback), vidi email/email.service.ts.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@domain.com

# Lemon Squeezy - naplata restorana ZA KORISTENJE PLATFORME (nas prihod, ne
# restoranov). GLOBALNI kredencijali (jedna nasa prodavnica), za razliku od
# Twilio/Stripe koji su po restoranu (vidi restaurants.service.ts). Prazno = /billing/checkout vraca 400.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Webshop (fizicki hardver - termalni printeri) - odvojena "custom" varijanta u istom LS store-u, cijena se uvijek prepisuje na stvarni iznos narudzbe (custom_price)
LEMONSQUEEZY_SHOP_VARIANT_ID=

# Nalog platforme (SUPER_ADMIN) - koristi `npm run create-super-admin` (jednokratno, vidi prisma/create-super-admin.ts)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FULL_NAME=Platform Admin

# At-rest enkripcija Twilio/Stripe tajni polja (AES-256-GCM). Generisi sa:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NE MIJENJATI nakon prve upotrebe u produkciji - postojeci enkriptovani podaci postaju necitljivi (potrebna re-enkripcija).
ENCRYPTION_KEY=

# Brute-force zastita login-a (po nalogu, pored @Throttle po IP-u na /auth/login)
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Email verifikacija - link u emailu vodi na ovu stranicu + ?token=... (ne blokira login, samo prikazuje banner dok se ne potvrdi)
STAFF_VERIFY_EMAIL_URL=https://staff.domain.com/verify-email
