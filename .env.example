# Varijable za root docker-compose.yml (cloud dio platforme).
# Kopiraj u .env i popuni prije "docker compose up".
#
# NAPOMENA: Twilio/Stripe kredencijali se NE stavljaju ovdje - svaki
# restoran ih unosi u svom Admin panelu (Postavke), cuvaju se po restoranu
# u bazi. Vidi api/src/restaurants/restaurants.service.ts.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=restoran

# Dijeli ga api i websocket-gateway - MORA biti isti u oba da bi
# websocket-gateway mogao verifikovati staff JWT lokalno.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
REFRESH_EXPIRES_IN=30d

# Tajni token koji print-gateway agenti moraju poslati da bi se povezali na /agents namespace
PRINT_AGENT_SHARED_SECRET=change-me

# Service-to-service tajna (websocket-gateway -> api, interne rute)
INTERNAL_SERVICE_SECRET=change-me

# Domene sa kojih se smije pozivati API/WS (bez zavrsne kose crte)
CORS_ORIGINS=https://app.domain.com,https://staff.domain.com

# Koristi se za success/cancel URL nakon Stripe Checkout-a (takeaway online placanje)
PWA_BASE_URL=https://app.domain.com

# Sopstveni javni URL API-ja - koristi se za apsolutne linkove ka otpremljenim slikama (meni artikli, webshop proizvodi)
API_PUBLIC_URL=https://api.domain.com

# Opciono - error tracking (Sentry). Prazno = iskljuceno.
SENTRY_DSN=

TABLE_SESSION_TTL_SECONDS=14400

# Build-time varijable za Next.js frontende (ugradjuju se u JS bundle,
# zato moraju biti JAVNI - konacni URL-ovi na kojima ce servisi ziviti).
NEXT_PUBLIC_API_BASE_URL=https://app.domain.com/api
NEXT_PUBLIC_WS_URL=https://ws.domain.com
NEXT_PUBLIC_GUEST_PWA_URL=https://app.domain.com
NEXT_PUBLIC_ADMIN_URL=https://staff.domain.com
