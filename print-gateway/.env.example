# URL cloud servera (Socket.io namespace za print agente)
SERVER_WS_URL=https://api.domain.com

# Jedinstveni identifikator restorana (UUID iz tabele restaurants)
RESTAURANT_ID=00000000-0000-0000-0000-000000000000

# Tajni token agenta - server ga koristi da autentikuje ovaj lokalni gateway
# (generise se u admin panelu prilikom registracije printer-agenta)
AGENT_TOKEN=change-me

# Mapiranje logickih meta ('kitchen', 'bar', ...) na IP:port fizickih printera na LAN mrezi.
# Moze se i povuci sa servera pri konekciji (vidi index.js -> printer_config event),
# ali lokalni fallback je koristan ako server nije dostupan.
PRINTER_KITCHEN_IP=192.168.1.150
PRINTER_KITCHEN_PORT=9100
PRINTER_BAR_IP=192.168.1.151
PRINTER_BAR_PORT=9100

# Kodna stranica za dijakritike (cCzZsSdD) - CP852 pokriva bs/hr/sr latinicu
PRINTER_CODEPAGE=CP852

# Sirina papira u karakterima (58mm ~ 32 char, 80mm ~ 48 char)
PRINTER_WIDTH_CHARS=42

# Koliko puta pokusati ponovo poslati posao ako printer ne odgovori
PRINT_RETRY_ATTEMPTS=3
PRINT_RETRY_DELAY_MS=2000

# Fajl u koji se cuva neposlata queue (za slucaj da agent padne dok je printer offline)
QUEUE_FILE=./data/pending-jobs.json

LOG_LEVEL=info
